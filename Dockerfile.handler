# Сборка «только хендлер» (20.10): берём проверенный рабочий образ целиком и
# меняем в нём один handler.py — torch, ComfyUI, кастом-ноды и пакеты остаются
# байт в байт прежними. Полный Dockerfile ставит их без пинов (последний torch,
# master кастом-нод), и пересборка с нуля даёт другой стек — 20.10 так и вышло.
# Поэтому правки хендлера катим этим файлом; базу менять осознанно, после
# проверки нового полного образа на канарейке. Правки scripts/, requirements.txt
# и Dockerfile в этот образ НЕ попадают — для них нужна полная сборка (full=true,
# тег sha-<коммит>-full) и проверка.
# База закреплена и тегом, и дайджестом: тег можно перезаписать, дайджест — нет.
ARG BASE_IMAGE=ghcr.io/soldatsc/minmxh3:sha-278e6f6@sha256:8a9e60021a8d09ae7ac3853296392bc8f7920e6637743d1234bd5c5e9fd894a4
FROM ${BASE_IMAGE}

# --link: слой собирается отдельно от базы, раннеру не нужно качать и
# распаковывать 8 ГБ базового образа ради одного файла.
COPY --link handler.py /handler.py
