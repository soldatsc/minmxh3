# Сборка «только хендлер» (20.10): берём проверенный рабочий образ целиком и
# меняем в нём один handler.py — torch, ComfyUI, кастом-ноды и пакеты остаются
# байт в байт прежними. Полный Dockerfile ставит их без пинов (последний torch,
# master кастом-нод), и пересборка с нуля даёт другой стек — 20.10 так и вышло.
# Поэтому правки хендлера катим этим файлом; базу менять осознанно, после
# проверки нового полного образа на канарейке.
ARG BASE_IMAGE=ghcr.io/soldatsc/minmxh3:sha-278e6f6
FROM ${BASE_IMAGE}

COPY handler.py /handler.py
